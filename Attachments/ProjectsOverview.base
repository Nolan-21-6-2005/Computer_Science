views:
  - type: table
    name: Project
    filters:
      and:
        - file.folder == "01_Projects"
    order:
      - file.name
      - deadline
      - start_date
      - type
      - status
      - priority
    columnSize:
      file.name: 325
      note.status: 70
      note.priority: 186
  - type: cards
    name: Working Session
    filters:
      and:
        - file.folder == "02_Areas/Work Sessions"
    order:
      - file.name
      - date
      - type
      - category
      - start
      - end
    cardSize: 240
    imageAspectRatio: 1
