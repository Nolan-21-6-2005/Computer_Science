views:
  - type: cards
    name: 02 - Projects
    filters:
      and:
        - file.inFolder("02_Projects")
    order:
      - file.name
      - status
    cardSize: 150
  - type: cards
    name: 03 - Learning
    filters:
      and:
        - file.inFolder("03_Learning")
    order:
      - file.name
      - file.folder
    cardSize: 150
  - type: cards
    name: 06 - Archive
    filters:
      and:
        - file.inFolder("06_Archive")
    cardSize: 150
